{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Planning Assistant API",
    "description": "Backend API for AI-augmented shipyard and port logistics planning",
    "version": "0.1.0",
    "contact": {
      "name": "Seatrium Development Team",
      "email": "dev@seatrium.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    },
    {
      "url": "https://api.planning-assistant.seatrium.com",
      "description": "Production server (Azure deployment)"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Root health check",
        "operationId": "root_health_check",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "service": { "type": "string", "example": "AI Planning Assistant API" },
                    "version": { "type": "string", "example": "0.1.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Detailed health check",
        "description": "Returns detailed status of database and AI service connections",
        "operationId": "health_check",
        "tags": ["health"],
        "responses": {
          "200": {
            "description": "Health check response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthCheckResponse" }
              }
            }
          }
        }
      }
    },
    "/api/plans/upload": {
      "post": {
        "summary": "Upload planning data",
        "description": "Upload CSV or Excel file with planning data (tasks, resources, constraints)",
        "operationId": "upload_plan",
        "tags": ["plans"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "name"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Planning data file (CSV or Excel)"
                  },
                  "name": {
                    "type": "string",
                    "description": "Plan name"
                  },
                  "description": {
                    "type": "string",
                    "description": "Plan description (optional)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan uploaded successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanUploadResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid file format",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}": {
      "get": {
        "summary": "Get plan by ID",
        "description": "Retrieve complete plan data including tasks, resources, assumptions, and recommendations",
        "operationId": "get_plan",
        "tags": ["plans"],
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Plan ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Plan data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Plan" }
              }
            }
          },
          "404": {
            "description": "Plan not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/generate": {
      "post": {
        "summary": "Generate AI plan",
        "description": "Generate optimized plan using Azure OpenAI reasoning models (typically 3-5 minutes)",
        "operationId": "generate_plan",
        "tags": ["plans"],
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Plan ID"
          }
        ],
        "responses": {
          "200": {
            "description": "AI plan generated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Plan" }
              }
            }
          },
          "408": {
            "description": "Plan generation timeout",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/plans/compare": {
      "post": {
        "summary": "Compare two plans",
        "description": "Generate side-by-side comparison with differences, trade-offs, and improvements",
        "operationId": "compare_plans",
        "tags": ["plans"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["plan_id_1", "plan_id_2"],
                "properties": {
                  "plan_id_1": { "type": "integer", "description": "First plan ID (typically human plan)" },
                  "plan_id_2": { "type": "integer", "description": "Second plan ID (typically AI plan)" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan comparison",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanComparison" }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/constraints": {
      "post": {
        "summary": "Update constraints and regenerate plan",
        "description": "Modify constraints or assumptions and trigger plan regeneration",
        "operationId": "update_constraints",
        "tags": ["plans"],
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "Plan ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "constraints": {
                    "type": "object",
                    "description": "Updated constraint values"
                  },
                  "regenerate": {
                    "type": "boolean",
                    "description": "Whether to regenerate plan immediately",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Constraints updated and plan regenerated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Plan" }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/recommendations/{recommendation_id}": {
      "post": {
        "summary": "Accept or reject recommendation",
        "description": "User decision on AI recommendation (human-in-the-loop)",
        "operationId": "decide_recommendation",
        "tags": ["recommendations"],
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "recommendation_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["accept"],
                "properties": {
                  "accept": {
                    "type": "boolean",
                    "description": "Whether to accept the recommendation"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recommendation decision recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SuccessResponse" }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/export": {
      "get": {
        "summary": "Export plan",
        "description": "Export finalized plan in specified format (CSV, Gantt chart, JSON)",
        "operationId": "export_plan",
        "tags": ["plans"],
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["csv", "gantt", "json"]
            },
            "description": "Export format"
          }
        ],
        "responses": {
          "200": {
            "description": "Plan exported successfully",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthCheckResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "healthy" },
          "database": { "type": "string", "example": "connected" },
          "ai_service": { "type": "string", "example": "connected" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "PlanUploadResponse": {
        "type": "object",
        "required": ["plan_id", "name", "status", "tasks_count", "resources_count", "message"],
        "properties": {
          "plan_id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Shipyard Construction Q1" },
          "status": { "type": "string", "example": "uploaded" },
          "tasks_count": { "type": "integer", "example": 20 },
          "resources_count": { "type": "integer", "example": 15 },
          "message": { "type": "string", "example": "Plan uploaded successfully" }
        }
      },
      "Plan": {
        "type": "object",
        "required": ["name", "status", "lineage", "tasks", "resources"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Shipyard Construction Q1" },
          "description": { "type": "string", "example": "Vessel construction plan for Q1 2026" },
          "status": {
            "type": "string",
            "enum": ["uploaded", "parsing", "generating", "completed", "failed"],
            "example": "completed"
          },
          "lineage": {
            "type": "string",
            "enum": ["ai_generated", "human_created", "hybrid"],
            "example": "ai_generated"
          },
          "total_duration_days": { "type": "number", "example": 60.5 },
          "capacity_utilization": { "type": "number", "example": 85.3 },
          "total_cost": { "type": "number", "example": 650000 },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "tasks": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Task" }
          },
          "resources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Resource" }
          },
          "assumptions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Assumption" }
          },
          "recommendations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Recommendation" }
          }
        }
      },
      "Task": {
        "type": "object",
        "required": ["task_id", "name", "duration_days", "lineage"],
        "properties": {
          "task_id": { "type": "string", "example": "T001" },
          "name": { "type": "string", "example": "Hull Assembly - Section A" },
          "duration_days": { "type": "number", "example": 14 },
          "start_date": { "type": "string", "format": "date-time" },
          "end_date": { "type": "string", "format": "date-time" },
          "resource_requirements": { "type": "object" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["T000"]
          },
          "constraints": { "type": "object" },
          "priority": { "type": "string", "example": "High" },
          "cost": { "type": "number", "example": 50000 },
          "lineage": { "type": "string", "enum": ["ai_generated", "human_created", "hybrid"] }
        }
      },
      "Resource": {
        "type": "object",
        "required": ["resource_id", "name", "type"],
        "properties": {
          "resource_id": { "type": "string", "example": "R001" },
          "name": { "type": "string", "example": "Crane A" },
          "type": { "type": "string", "enum": ["Equipment", "Personnel", "Facility"], "example": "Equipment" },
          "capacity": { "type": "integer", "example": 1 },
          "availability_start": { "type": "string", "format": "date-time" },
          "availability_end": { "type": "string", "format": "date-time" },
          "hourly_cost": { "type": "number", "example": 150 },
          "skills": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["Heavy Lifting"]
          }
        }
      },
      "Assumption": {
        "type": "object",
        "required": ["assumption_type", "description"],
        "properties": {
          "assumption_type": { "type": "string", "example": "priority_weighting" },
          "description": { "type": "string", "example": "High-priority tasks scheduled first" },
          "value": { "type": "string", "example": "weight=2.0" }
        }
      },
      "Recommendation": {
        "type": "object",
        "required": ["recommendation_type", "affected_entities", "rationale"],
        "properties": {
          "recommendation_type": { "type": "string", "example": "task_reschedule" },
          "affected_entities": { "type": "object", "example": { "task_id": "T003" } },
          "rationale": { "type": "string", "example": "Reduces resource contention" },
          "impact_metrics": { "type": "object" },
          "status": { "type": "string", "enum": ["pending", "accepted", "rejected"], "example": "pending" }
        }
      },
      "PlanComparison": {
        "type": "object",
        "properties": {
          "plan_1": { "$ref": "#/components/schemas/Plan" },
          "plan_2": { "$ref": "#/components/schemas/Plan" },
          "differences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "example": "task_date_change" },
                "entity_id": { "type": "string", "example": "T003" },
                "description": { "type": "string", "example": "Task T003 moved from Week 2 to Week 4" },
                "impact": { "type": "object" }
              }
            }
          },
          "trade_offs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string", "example": "AI plan reduces schedule by 10% but increases resource utilization by 5%" },
                "metrics": { "type": "object" }
              }
            }
          },
          "improvements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "example": "capacity_utilization" },
                "description": { "type": "string", "example": "Greater capacity utilization" },
                "metric_value": { "type": "number", "example": 5.3 }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string", "example": "Validation Error" },
          "detail": { "type": "string", "example": "Invalid file format" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Operation completed successfully" },
          "data": { "type": "object" }
        }
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Health check endpoints"
    },
    {
      "name": "plans",
      "description": "Plan management operations"
    },
    {
      "name": "recommendations",
      "description": "AI recommendation operations"
    }
  ]
}
